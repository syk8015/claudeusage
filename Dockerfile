# 이 서버는 맥에서 쓰는 도구다. 컨테이너는 **디렉터리를 뒤지라고 있는 게 아니라**,
# 레지스트리(glama.ai 등)가 샌드박스에서 서버를 띄워 tools/list 를 물어보기 위한 것이다.
# 우리가 안 주면 저쪽이 AI 로 추측해 만드는데, 그게 실패하면 검색에서 빠진다.
#
# 컨테이너 안에는 볼 기록이 없으므로 분석 도구는 "기록이 없다"고 답한다. 그게 맞다.
# 실제로 쓰려면 맥에서 ./install.sh 로 설치할 것 (README 참고).
FROM python:3.12-slim

WORKDIR /app
COPY . /app

# 의존성이 없다. 표준 라이브러리만 쓴다.
CMD ["python3", "tools/mcp-server.py"]
